{
  "name": "solar-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "tsx scripts/db-server.ts",
    "db:down": "tsx scripts/db-stop.ts",
    "db:migrate": "dotenv -e .env.development.local -- node-pg-migrate up -m db/migrations",
    "db:migrate:down": "dotenv -e .env.development.local -- node-pg-migrate down -m db/migrations",
    "db:migrate:test": "dotenv -e .env.test.local -- node-pg-migrate up -m db/migrations",
    "db:types": "dotenv -e .env.development.local -- kysely-codegen --dialect postgres --default-schema public --include-pattern \"{om,public}.*\" --out-file lib/db/types.ts",
    "db:reset": "dotenv -e .env.development.local -- tsx scripts/db-reset-local.ts && npm run db:migrate"
  },
  "dependencies": {
    "kysely": "0.29.5",
    "next": "16.3.5",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "11.0.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "kysely-codegen": "0.20.0",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5"
  }
}
