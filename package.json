{
  "name": "solar-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "fonts:sync": "tsx scripts/fonts-sync.ts",
    "db:up": "tsx scripts/db-server.ts",
    "db:down": "tsx scripts/db-stop.ts",
    "db:migrate": "dotenv -e .env.development.local -- tsx scripts/db-migrate.ts up",
    "db:migrate:down": "dotenv -e .env.development.local -- tsx scripts/db-migrate.ts down",
    "db:migrate:test": "dotenv -e .env.test.local -- tsx scripts/db-migrate.ts up",
    "db:types": "dotenv -e .env.development.local -- kysely-codegen --dialect postgres --default-schema public --include-pattern \"{om,public,sim}.*\" --out-file lib/db/types.ts",
    "db:seed": "dotenv -e .env.development.local -- tsx scripts/db-seed.ts --env-file .env.development.local",
    "db:seed:test": "dotenv -e .env.test.local -- tsx scripts/db-seed.ts --env-file .env.test.local",
    "db:reset": "dotenv -e .env.development.local -- tsx scripts/db-reset-local.ts && npm run db:migrate",
    "db:rollup:rebuild": "dotenv -e .env.development.local -- tsx scripts/db-rollup-rebuild.ts",
    "sim:backfill": "dotenv -e .env.development.local -- tsx scripts/sim-backfill.ts",
    "sim:live": "dotenv -e .env.development.local -- tsx scripts/sim-live.ts",
    "verify:ingest": "dotenv -e .env.development.local -- tsx scripts/verify-ingest.ts",
    "sim:eval": "dotenv -e .env.development.local -- tsx scripts/sim-eval.ts",
    "analyze": "dotenv -e .env.development.local -- tsx scripts/analyze.ts",
    "admin:create": "dotenv -e .env.development.local -- tsx scripts/admin-create.ts",
    "admin:create:test": "dotenv -e .env.test.local -- tsx scripts/admin-create.ts"
  },
  "dependencies": {
    "better-auth": "1.7.4",
    "echarts": "6.1.0",
    "kysely": "0.29.5",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-kakao-maps-sdk": "1.2.2",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "11.0.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "kysely-codegen": "0.20.0",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
