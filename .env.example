# 로컬 개발용 예시. 복사해서 사용한다 (둘 다 git에 올라가지 않음).
#   개발: .env.development.local  → DB 이름 hysol
#   테스트: .env.test.local       → DB 이름 hysol_test
# 로컬 DB는 `npm run db:up` 으로 띄운 embedded-postgres (포트 54320).
DATABASE_URL=postgres://hysol:hysol@localhost:54320/hysol

# Better Auth. 비밀값은 파일마다 따로 생성한다 (32자 이상):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
