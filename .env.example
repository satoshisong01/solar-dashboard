# 로컬 개발용 예시. 복사해서 사용한다 (둘 다 git에 올라가지 않음).
#   개발: .env.development.local  → DB 이름 hysol
#   테스트: .env.test.local       → DB 이름 hysol_test
# 로컬 DB는 `npm run db:up` 으로 띄운 embedded-postgres (포트 54320).
DATABASE_URL=postgres://hysol:hysol@localhost:54320/hysol

# DB 연결 TLS. disable(기본, 로컬) | require(암호화만, 인증서 미검증) | verify-full(CA·호스트 검증)
# sslmode 등 SSL 파라미터는 DATABASE_URL에 넣지 않는다 (넣으면 시작 시 오류).
#
# 운영 RDS로 전환하는 방법 (앱 코드는 DATABASE_URL만 읽는다. DB_HOST 등 옛 변수는 쓰지 않음):
#   1) RDS CA 번들을 받는다: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
#   2) DATABASE_URL=postgres://<user>:<password>@<rds-endpoint>:5432/<db>
#      DATABASE_SSL=verify-full
#      DATABASE_SSL_CA_PATH=<global-bundle.pem 경로>
#   3) 마이그레이션은 scripts/db-migrate.ts가 위 세 변수를 그대로 반영한다 (README "운영 RDS에 마이그레이션 적용"):
#      npx dotenv -e <운영용 env 파일> -- tsx scripts/db-migrate.ts up
#      (.env.development.local을 읽는 npm run db:migrate는 로컬 전용)
#   require는 인증서를 검증하지 않아 중간자 공격에 취약하므로 운영에는 쓰지 않는다.
DATABASE_SSL=disable
DATABASE_SSL_CA_PATH=

# 게이트웨이 HMAC 비밀값(om.gateway_key.secret_enc)을 AES-256-GCM으로 암호화하는 키. 필수.
# base64로 인코딩한 32바이트이며 파일(환경)마다 따로 생성한다:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 키를 바꾸면 기존 게이트웨이 키를 복호화할 수 없다 (로컬은 npm run db:seed로 다시 암호화).
INGEST_KEY_ENC_KEY=

# Better Auth. 비밀값은 파일마다 따로 생성한다 (32자 이상):
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# 선택: BETTER_AUTH_URL 외에 로그인 요청을 허용할 origin (쉼표로 구분, 예: 프리뷰 배포 도메인)
BETTER_AUTH_TRUSTED_ORIGINS=

# 선택: 안전감시 공백 기준(분, 기본 10). 수소·ESS 설비가 있는 사이트의 게이트웨이가 이 시간 이상 무수신이면 안전 화면에 표시한다.
SAFETY_SILENCE_MINUTES=

# 선택(개발 플래그): 1이면 시뮬레이터 스코어카드 화면(/sim)과 메뉴를 연다. 비우면 /sim은 찾을 수 없음.
HYSOL_SHOW_SIM=

# 시뮬레이터 게이트웨이 개발용 HMAC 비밀값 (SIM_GATEWAY_SECRET_GW_SIMA_01 등).
# 직접 적지 않아도 된다: npm run db:seed / db:seed:test 가 없으면 생성해 이 파일 끝에 추가한다.

# 테스트(.env.test.local)에만: E2E 테스트 관리자 비밀번호 (12자 이상).
# npm run test:e2e 가 이 비밀번호로 e2e-admin@hysol.local 계정을 다시 만든다.
# E2E_ADMIN_PASSWORD=

# AI 설명 (선택). 없으면 발견사항 쉬운 요약은 규칙 기반 문장만 쓴다 (앱은 그대로 동작한다).
# 판정과 수치는 언제나 분석 엔진 값이고, 모델은 문장만 다시 쓴다.
GEMINI_API_KEY=
# 비우면 lib/llm/gemini.ts의 기본 모델(flash 계열 최신 GA)을 쓴다.
GEMINI_MODEL=
